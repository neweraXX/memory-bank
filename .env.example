# Any OpenAI-compatible endpoint works. Default: Google Gemini.
LLM_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai/
LLM_API_KEY=
LLM_MODEL=gemini-3.6-flash
LLM_FALLBACK_MODELS=gemini-3.5-flash,gemini-3.5-flash-lite
EMBED_MODEL=gemini-embedding-001
EMBED_DIMENSIONS=768

# Optional: persistent feedback store (Upstash Redis REST). Without it, feedback
# is kept in data/feedback.local.json locally, or in memory on serverless hosts.
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
